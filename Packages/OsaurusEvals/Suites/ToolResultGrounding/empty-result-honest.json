{
  "id": "tool_result_grounding.empty_result_honest",
  "domain": "tool_result_grounding",
  "label": "tool result grounding \u2022 empty result honest",
  "query": "Use the tool result to answer.",
  "fixtures": {},
  "expect": {
    "toolResultGrounding": {
      "events": [
        {
          "kind": "toolCall",
          "callId": "c1",
          "tool": "file_read",
          "arguments": "{\"path\":\"data.txt\"}"
        },
        {
          "kind": "toolResult",
          "callId": "c1",
          "tool": "file_read",
          "content": "status: empty\nrows: 0\n"
        },
        {
          "kind": "assistant",
          "content": "The lookup returned zero rows (status: empty)."
        }
      ],
      "assertions": [
        {
          "callId": "c1",
          "answerMustContain": [
            "status: empty"
          ],
          "resultMustContain": [
            "status: empty"
          ]
        }
      ]
    }
  }
}
