{
  "id": "tool_result_grounding.conflicting_results_refuse_stale",
  "domain": "tool_result_grounding",
  "label": "tool result grounding \u2022 conflicting results refuse stale",
  "query": "Use the tool result to answer.",
  "fixtures": {},
  "expect": {
    "toolResultGrounding": {
      "events": [
        {
          "kind": "toolCall",
          "callId": "c1",
          "tool": "file_read",
          "arguments": "{\"path\":\"data.txt\"}"
        },
        {
          "kind": "toolResult",
          "callId": "c1",
          "tool": "file_read",
          "content": "count: 42\nsource: latest\n"
        },
        {
          "kind": "assistant",
          "content": "The latest count is 42."
        }
      ],
      "assertions": [
        {
          "callId": "c1",
          "answerMustContain": [
            "42"
          ],
          "resultMustContain": [
            "count: 42"
          ]
        }
      ]
    }
  }
}
