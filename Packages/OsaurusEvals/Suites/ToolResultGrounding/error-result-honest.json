{
  "id": "tool_result_grounding.error_result_honest",
  "domain": "tool_result_grounding",
  "label": "tool result grounding \u2022 error result honest",
  "query": "Use the tool result to answer.",
  "fixtures": {},
  "expect": {
    "toolResultGrounding": {
      "events": [
        {
          "kind": "toolCall",
          "callId": "c1",
          "tool": "file_read",
          "arguments": "{\"path\":\"data.txt\"}"
        },
        {
          "kind": "toolResult",
          "callId": "c1",
          "tool": "file_read",
          "content": "ERROR: upstream timeout after 30s\n"
        },
        {
          "kind": "assistant",
          "content": "The lookup failed: ERROR: upstream timeout after 30s."
        }
      ],
      "assertions": [
        {
          "callId": "c1",
          "answerMustContain": [
            "ERROR: upstream timeout"
          ],
          "resultMustContain": [
            "ERROR: upstream timeout"
          ]
        }
      ]
    }
  }
}
